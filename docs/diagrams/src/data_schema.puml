@startuml data_schema

title Entity Relationship Diagram

hide circle
skinparam linetype ortho

entity "**App Users**" as AppUser {
    * _id : ObjectId
    ---
    * name : string
    * email : string
}

entity "**User**" as User {
    * _id : ObjectId
    ---
    * name : string
    * email : string
    * is_creator : boolean
    followed_channels : embedded []
    payments : embedded []
}

entity "**FollowedChannel**" as FollowedChannel {
    embedded in User
    ---
    channel : channel_id <ObjectId>

}

entity "**Payment**" as Payment {
    embedded in User
    ---
    channel : channel_id <ObjectId>
    date : timestamp
    expiry : timestamp

}

entity "**Channel**" as Channel {
    * _id : ObjectId
    ---
    * creator : user_id <ObjectId>
    * name : string
    * description : string
    ---
    reviews : embedded []
    rating : uint8 (0-5)
}

entity "**Workout**" as Workout {
    * _id : ObjectId
    ---
    * name : string
    * channel : channel_id <ObjectId>
    * sets : uint8
    * steps : embedded Step []
    ---
    * duration : time
    * tags : []
    * hidden_tags : []
    reviews : embedded Review []
    rating : aggregation uint8 (0-5)
    times_completed : aggregation int
    likes : int
}

entity "**WorkoutStep**" as Step {
    embedded in Workout
    ---
    * name : e.g. squats
    * type : duration or reps
    * count : int or time
}

entity "**WorkoutLog**" as WorkoutLog {
    * _id
    ---
    * user_id : objectid
    * workout_id : objectid
    * timestamp : timestamp
    * data : embedded WorkoutData []
}

entity "**WorkoutData**" as WorkoutData {
    embedded in WorkoutLog
    ---
    * time : time
    * is_rep : boolean
    * x : float
    * y : float
    * confidence : float
    * zscore : float
    * avg : float
    * stddev : float
    * n_stddev : float
}

Workout ||--|{ Step
Workout ||--o{ WorkoutLog

User ||--o{ WorkoutLog
User ||--o| Channel
User --o{ FollowedChannel
User --o{ Payment

Channel ||--o{ Workout
WorkoutLog ||--o{ WorkoutData

@enduml