@startuml data_schema

title Entity Relationship Diagram
' Follows the standards in: https://plantuml.com/ie-diagram

hide circle
skinparam linetype ortho

entity "**App Users**" as AppUser {
    * _id : ObjectId
    ---
    * name : string
    * email : string
}

entity "**Users**" as User {
    * _id : ObjectId
    * user_id : string <AppUser._id>
    * realm_id : string
    ---
    * name : string
    * email : string
    * is_creator : boolean
    followed_channels : embedded FollowedChannel []
    payments : embedded Payment []
}

entity "**FollowedChannel**" as FollowedChannel {
    embedded in User
    ---
    channel : ObjectId <Channels._id>

}

entity "**Payment**" as Payment {
    embedded in User
    ---
    channel : ObjectId <Channels._id>
    date : date
    expiry : date

}

entity "**Channels**" as Channel {
    * _id : ObjectId
    ' * channel_id : string
    * realm_id : string
    ---
    * creator_id : ObjectId <Users.user_id>
    * name : string
    * description : string
    ---
    reviews : embedded []
    rating : uint8 (0-5)
}

entity "**Workout**" as Workout {
    * _id : ObjectId
    * realm_id : string
    ---
    * name : string
    * channel_id : ObjectId <Channels._id>
    * sets : uint8
    * steps : embedded WorkoutStep (Timed or Rep) []
    ===
    Not implemented yet
    * duration : time
    * tags : []
    * hidden_tags : []
    reviews : embedded Review []
    rating : aggregation uint8 (0-5)
    times_completed : aggregation int
    likes : int
}

' TODO: Probably want some sort of enum for type
entity "**RepWorkoutStep**" as RepWorkoutStep {
    embedded in Workout or WorkoutLog
    ---
    * type: static string "RepWorkoutStep"
    * index : int
    * name : string (e.g. squats)
    * count : int
    timestamp : date
}

entity "**TimedWorkoutStep**" as TimedWorkoutStep {
    embedded in Workout or WorkoutLog
    ---
    * type: static string "TimedWorkoutStep"
    * index : int
    * name : string (e.g. squats)
    * duration : int (time in seconds)
    timestamp : date
}

entity "**WorkoutLog**" as WorkoutLog {
    * _id : ObjectId
    * realm_id : string
    ---
    * user_id : ObjectId <Users._id>
    * workout_id : ObjectId <Workouts._id>
    * start_time : date
    end_time : date
    steps : embedded WorkoutStepLog []
    data : embedded WorkoutData []
}

entity "**WorkoutData**" as WorkoutData {
    embedded in WorkoutLog
    ---
    * timestamp : date
    is_rep : bool
    raw: PoseEstimationData []
    zscore : double
    avg : double
    stddev : double
    n_stddev : double
}

entity "**PoseEstimationData**" as PoseEstimationData {
    embedded in WorkoutData
    ---
    * keypoint : string 
    * x : double
    * y : double
    * confidence : double
    algorithm : string
}

AppUser ||--|| User

Workout ||--|{ TimedWorkoutStep
Workout ||--|{ RepWorkoutStep
Workout ||--o{ WorkoutLog

WorkoutLog ||--|{ TimedWorkoutStep
WorkoutLog ||--|{ RepWorkoutStep

User ||--o{ WorkoutLog
User --o{ FollowedChannel
User --o{ Payment

FollowedChannel ||--|| Channel
Payment ||--|| Channel

Channel ||--o| User
Channel ||--o{ Workout
WorkoutLog ||--o{ WorkoutData
WorkoutData ||--o{ PoseEstimationData

@enduml