@startuml data_schema

title Entity Relationship Diagram

hide circle
skinparam linetype ortho

entity "**User**" as User {
    * _id : ObjectId
    ---
    * name : string
    * email : string
    fav_workouts : workout_id []
}

entity "**Workout**" as Workout {
    * _id : ObjectId
    ---
    * name : string
    * creator : user_id <ObjectId>
    * derived_from : workout_id <ObjectId>
    * duration : time
    * tags : []
    * hidden_tags : []
    * sets : uint8
    * steps : embedded []
    reviews : embedded []
    rating : uint8 (0-5)
    number_workouts : int
}

entity "**Steps**" as Steps {
    embedded in Workout
    ---
    * name : e.g. squats
    * type : duration or reps
    * count : int or time
}

entity "**WorkoutLog**" as WorkoutLog {
    * _id
    ---
    * user_id : id
    * workout_id : id
    * timestamp : time
    * stats on steps
}

Workout ||--|{ Steps
Workout ||--o{ WorkoutLog
User ||--o{ WorkoutLog
User ||--|| Workout

@enduml