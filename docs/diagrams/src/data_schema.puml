@startuml data_schema

title Entity Relationship Diagram

hide circle
skinparam linetype ortho

entity "**App Users**" as AppUser {
    * _id : ObjectId
    ---
    * name : string
    * email : string
}

entity "**Users**" as User {
    * _id : ObjectId
    * user_id : string
    * realm_id : string
    ---
    * name : string
    * email : string
    * is_creator : boolean
    followed_channels : embedded FollowedChannel []
    payments : embedded Payment []
}

entity "**FollowedChannel**" as FollowedChannel {
    embedded in User
    ---
    channel : string <Channels.channel_id>

}

entity "**Payment**" as Payment {
    embedded in User
    ---
    channel : string <Channels.channel_id>
    date : date
    expiry : date

}

entity "**Channels**" as Channel {
    * _id : ObjectId
    * channel_id : string
    * realm_id : string
    ---
    * creator : string <Users.user_id>
    * name : string
    * description : string
    ---
    reviews : embedded []
    rating : uint8 (0-5)
}

entity "**Workout**" as Workout {
    * _id : ObjectId
    * workout_id : string
    * realm_id : string
    ---
    * name : string
    * channel : string <Channels.channel_id>
    * sets : uint8
    * steps : embedded Step []
    ---
    * duration : time
    * tags : []
    * hidden_tags : []
    reviews : embedded Review []
    rating : aggregation uint8 (0-5)
    times_completed : aggregation int
    likes : int
}

entity "**WorkoutStep**" as Step {
    embedded in Workout
    ---
    * index : int
    * name : e.g. squats
    * type : duration or reps
    * count : int or time
}

entity "**WorkoutLog**" as WorkoutLog {
    * _id : ObjectId
    * realm_id : string
    ---
    * user_id : string <Users.user_id>
    * workout_id : ObjectId <Workouts.workout_id>
    * timestamp : date
    * steps : embedded WorkoutStepLog []
    * data : embedded WorkoutData []
}

entity "**WorkoutStepLog**" as WorkoutLogStep {
    embedded in WorkoutLog
    ---
    * index : int
    * count : int
}

entity "**WorkoutData**" as WorkoutData {
    embedded in WorkoutLog
    ---
    * time : date
    * is_rep : bool
    * x : double
    * y : double
    * confidence : double
    * zscore : double
    * avg : double
    * stddev : double
    * n_stddev : double
}

Workout ||--|{ Step
Workout ||--o{ WorkoutLog

WorkoutLog ||--o{ WorkoutLogStep

User ||--o{ WorkoutLog
User --o{ FollowedChannel
User --o{ Payment

FollowedChannel ||--|| Channel
Payment ||--|| Channel

Channel ||--o{ Workout
WorkoutLog ||--o{ WorkoutData

@enduml